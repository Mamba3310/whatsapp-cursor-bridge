# Values for this new integration only. Do not copy credentials from the A0 bridge.
# Meta webhook verification token: choose a separate random value and configure it in Meta.
VERIFY_TOKEN=replace-with-a-new-random-secret
META_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_TOKEN=replace-with-separate-whatsapp-cloud-api-token
PHONE_NUMBER_ID=replace-with-whatsapp-sender-phone-number-id
# Create a Cursor user API key at cursor.com/dashboard/api; do not commit it.
CURSOR_API_KEY=replace-with-cursor-api-key
# Connected repository Cursor Cloud Agent should work in.
CURSOR_REPO_URL=https://github.com/your-org/your-repo
# Optional starting branch, e.g. main.
CURSOR_STARTING_REF=
# Comma-separated approved WhatsApp sender IDs, without plus sign.
ALLOWED_WA_IDS=replace-with-your-telegram-independent-whatsapp-sender-id
# Public HTTPS host must route /webhook to this app.
PORT=3000
META_GRAPH_VERSION=v23.0
# Persistent local map from approved WhatsApp sender to Cursor agent ID.
AGENT_STORE_PATH=./data/agents.json
